MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/blinkit?retryWrites=true&w=majority
MONGO_DB_NAME=blinkit
# Optional collection overrides
# MONGO_PRODUCTS_COLLECTION=products
# MONGO_ORDERS_COLLECTION=orders
# MONGO_ADMIN_USERS_COLLECTION=admin_users
PORT=5000
ADMIN_USERNAME=parveen@marioxsoftware.com
ADMIN_EMAIL=parveen@marioxsoftware.com
ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD
ADMIN_QR_RESET_PASSWORD=REPLACE_WITH_QR_RESET_PASSWORD
# Auth note: Google Authenticator QR reset now uses admin username/email + password
# via POST /api/admin/2fa/reset-and-generate (no QR email flow).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=parveen@marioxsoftware.com
SMTP_PASS=REPLACE_WITH_GMAIL_APP_PASSWORD
MAIL_FROM=parveen@marioxsoftware.com
